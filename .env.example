# Пароль входу до вебпанелі. Без логіна. init_env.py згенерує його автоматично.
APP_PASSWORD=GENERATE_APP_PASSWORD

# Ключ розширення: скопіюйте в VITE_CLIENT_KEY / налаштування розширення.
# Розширення передає його у заголовку X-Client-Key.
CLIENT_KEY=GENERATE_CLIENT_KEY

# Ключ шифрування бази: НЕ змінюйте для вже створеної бази, зберігайте резервну копію.
ENCRYPTION_KEY=GENERATE_ENCRYPTION_KEY

# Адреса Keitaro: без /admin та без /admin_api/v1, обов'язково HTTPS.
KEITARO_URL=

# Токен Keitaro Admin API (не токен кампанії).
KEITARO_API_KEY=

# Версія Meta Graph API, яку підтримує ваш токен.
META_API_VERSION=v23.0

# true для сервера з HTTPS. Для локального http://127.0.0.1:8000 поставте false.
COOKIE_SECURE=true

# Шлях відносно робочої папки програми або абсолютний шлях.
DATABASE_PATH=data/spend/spend.sqlite

# Фоновий обробник; у звичайному використанні залиште true.
SCHEDULER_ENABLED=true

# Початкова проксі. Імпортується лише один раз, далі редагуйте через вебпанель.
# http://host:port:username:password[https://provider/change-ip]
INITIAL_PROXY=
